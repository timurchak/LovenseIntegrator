<ResourceDictionary
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:LovenseIntegrator.Desktop.Localization" xmlns:vm="clr-namespace:LovenseIntegrator.Desktop.ViewModels"
 xmlns:controls="clr-namespace:LovenseIntegrator.Desktop.Controls">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
 <vm:ActionCheckedConverter x:Key="ActionChecked"/>
 <Style TargetType="{x:Type controls:AssignmentEditorView}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:AssignmentEditorView}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="RuleName" Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" FontSize="17" FontWeight="SemiBold" ToolTip="{loc:Tr Text='Rule name'}"/>
   <CheckBox Grid.Column="1" Content="{loc:Tr Text='Enabled'}" IsChecked="{Binding Draft.Enabled}" Margin="12,0,0,0"/>
  </Grid>
  <ScrollViewer x:Name="EditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="Editor" Margin="0,0,12,0">
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{loc:Tr Text='01  Trigger'}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
     <Button x:Name="ShowEffectButton" Grid.Column="1" Content="{loc:Tr Text='Edit effect ↓'}" Margin="0" Padding="10,6"/>
    </Grid>
    <ContentPresenter Content="{TemplateBinding TriggerContent}"/>
    <Border Height="1" Background="#E4E6EE" Margin="0,16,0,16"/>
    <Grid x:Name="EffectSection"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel>
           <TextBlock Text="{loc:Tr Text='02  Effect'}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
           <Expander Header="{loc:Tr Text='Copy saved effect'}" Margin="0,0,0,10"><StackPanel>
            <ComboBox x:Name="EffectSourceSelector" ItemsSource="{Binding EffectSources}" DisplayMemberPath="Name"/>
            <TextBlock Text="{loc:Tr Text='Copies the effect and toy target. Your trigger and conditions stay unchanged.'}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,6"/>
            <Button x:Name="CopyEffectButton" Content="{loc:Tr Text='Apply effect'}" HorizontalAlignment="Left"/>
           </StackPanel></Expander>
           <UniformGrid Columns="2" IsEnabled="{Binding Draft.AllowMouseEffects}">
            <RadioButton Style="{StaticResource EffectChoice}" Content="{loc:Tr Text='Vibration'}" Tag="Vibrate"  FontSize="12" Margin="0,0,6,6" IsChecked="{Binding Draft.Action, Converter={StaticResource ActionChecked}, ConverterParameter=Vibrate, Mode=OneWay}"/>
            <RadioButton Style="{StaticResource EffectChoice}" Content="{loc:Tr Text='Pulse'}" Tag="Pulse"  FontSize="12" IsChecked="{Binding Draft.Action, Converter={StaticResource ActionChecked}, ConverterParameter=Pulse, Mode=OneWay}"/>
            <RadioButton Style="{StaticResource EffectChoice}" Content="{loc:Tr Text='Speed-based'}" Tag="RateMapped"  FontSize="12" Margin="0,0,6,6" IsEnabled="{Binding Draft.SupportsSpeedMapping}" ToolTip="{loc:Tr Text='For fast and slow typing events'}" IsChecked="{Binding Draft.Action, Converter={StaticResource ActionChecked}, ConverterParameter=RateMapped, Mode=OneWay}"/>
            <RadioButton Style="{StaticResource EffectChoice}" Content="{loc:Tr Text='Stop'}" Tag="Stop"  FontSize="12" IsChecked="{Binding Draft.Action, Converter={StaticResource ActionChecked}, ConverterParameter=Stop, Mode=OneWay}"/>
           </UniformGrid>
           <TextBlock Text="{loc:Tr Text='Toy'}" Style="{StaticResource Label}"/><ComboBox x:Name="TargetSelector" ItemsSource="{Binding Targets}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Draft.ToyId}"/>
           <StackPanel x:Name="EffectSettings" Visibility="{Binding Draft.ShowEffect, Converter={StaticResource Visible}}">
            <Grid Margin="0,16,0,8"><TextBlock Text="{loc:Tr Text='Intensity'}"/><TextBlock Text="{Binding Draft.IntensityText}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Grid>
            <Slider x:Name="IntensitySlider" Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Draft.Intensity}"/>
            <WrapPanel Margin="0,8,0,0"><Button Content="{loc:Tr Text='Soft'}" Tag="intensity:3" FontSize="10" Padding="8,5"/><Button Content="{loc:Tr Text='Medium'}" Tag="intensity:7" FontSize="10" Padding="8,5"/><Button Content="{loc:Tr Text='Strong'}" Tag="intensity:12" FontSize="10" Padding="8,5" Margin="0"/></WrapPanel>
            <Grid Margin="0,16,0,8"><TextBlock Text="{loc:Tr Text='Duration'}"/><TextBlock Text="{Binding Draft.DurationText}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Grid>
            <TextBlock Text="{loc:Tr Text='Duration · ms'}" Style="{StaticResource Label}"/><TextBox Text="{Binding Draft.DurationMilliseconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
            <Slider x:Name="DurationSlider" Minimum="0.1" Maximum="{Binding Draft.DurationSliderMaximum}" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Draft.DurationSeconds}"/>
            <WrapPanel Margin="0,8,0,0"><Button Content="{loc:Tr Text='100 ms'}" Tag="duration:0.1" FontSize="10" Padding="9,5"/><Button Content="{loc:Tr Text='150 ms'}" Tag="duration:0.15" FontSize="10" Padding="9,5"/><Button Content="{loc:Tr Text='250 ms'}" Tag="duration:0.25" FontSize="10" Padding="9,5" Margin="0"/></WrapPanel>
            <TextBlock Text="{loc:Tr Text='Effects up to 1 s require direct Bluetooth. Rapid pulses may merge: adjust cooldown between effects.'}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
            <WrapPanel Margin="0,8,0,0"><Button Content="{loc:Tr Text='2 s'}" Tag="duration:2" FontSize="10" Padding="9,5"/><Button Content="{loc:Tr Text='3 s'}" Tag="duration:3" FontSize="10" Padding="9,5"/><Button Content="{loc:Tr Text='5 s'}" Tag="duration:5" FontSize="10" Padding="9,5"/><Button Content="{loc:Tr Text='10 s'}" Tag="duration:10" FontSize="10" Padding="9,5" Margin="0"/></WrapPanel>
            <StackPanel x:Name="PulseSettings" Visibility="{Binding Draft.ShowPulse, Converter={StaticResource Visible}}"><TextBlock Text="{Binding Draft.PulseText}" Style="{StaticResource Label}"/><Slider Minimum="0.15" Maximum="10" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Draft.PulseSeconds}"/></StackPanel>
            <TextBlock Text="{loc:Tr Text='On trigger: speed / threshold × intensity, capped at 20. The preview shows the level at the threshold.'}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,10,0,0" Visibility="{Binding Draft.ShowMapping, Converter={StaticResource Visible}}"/>
           </StackPanel>
</StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="{loc:Tr Text='Effect over time · preview'}" Foreground="{StaticResource Muted}" FontSize="12"/>
      <controls:EffectPreview x:Name="EffectGraph" Height="85" Kind="{Binding Draft.Action}" Intensity="{Binding Draft.Intensity}" Duration="{Binding Draft.MousePreviewDuration}" Pulse="{Binding Draft.PulseMs}"/>
      <Border Background="#F2EEFD" CornerRadius="8" Padding="12" Margin="0,8,0,12"><TextBlock Text="{Binding Summary}" FontSize="12"/></Border>
      <TextBlock Text="{loc:Tr Text='Application'}" Style="{StaticResource Label}"/>
      <ComboBox x:Name="ApplicationSelector" ItemsSource="{Binding Applications}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Draft.Process, Mode=OneWay}"/>
      <TextBlock Text="{loc:Tr Text='Window title contains'}" Style="{StaticResource Label}"/><TextBox Text="{Binding Draft.WindowTitleContains, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{loc:Tr Text='Cooldown · ms'}" Style="{StaticResource Label}"/><TextBox x:Name="CooldownInput" Text="{Binding Draft.CooldownMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ToolTip="{loc:Tr Text='Minimum interval between effects. Presses during cooldown are skipped.'}"/>
      <Expander x:Name="AdvancedSettings" Header="{loc:Tr Text='Advanced settings'}" Margin="0,14,0,8"><StackPanel>
       <TextBlock Text="{loc:Tr Text='Priority · higher wins'}" Style="{StaticResource Label}"/><TextBox Text="{Binding Draft.Priority, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
       <TextBlock Text="{loc:Tr Text='When several rules match, the highest-priority rule wins.'}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
      </StackPanel></Expander>
     </StackPanel>
    </Grid>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <WrapPanel><Button x:Name="SaveAssignmentButton" Content="{loc:Tr Text='Save assignment'}" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"/><Button Content="{loc:Tr Text='Test effect'}" x:Name="TestAssignmentButton"/></WrapPanel>
   <Button Grid.Column="1" Content="{loc:Tr Text='Delete assignment'}" x:Name="DeleteAssignmentButton" Background="#FFF0F1" Foreground="#B13C50" BorderBrush="#F1D6DB" Margin="0"/>
  </Grid>
 </Grid>
 </ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
