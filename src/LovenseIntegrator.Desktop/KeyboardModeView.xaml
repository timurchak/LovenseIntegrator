<UserControl x:Class="LovenseIntegrator.Desktop.KeyboardModeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:LovenseIntegrator.Desktop.Controls" Language="en-US">
 <UserControl.Resources>
  <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="3"/><Setter Property="Foreground" Value="#30344B"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D8DCE8"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,6,6"/></Style>
 </UserControl.Resources>
 <Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Keyboard" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Select keys on the layout and assign an effect" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
    <Border Grid.Column="1" Background="#F0EBFF" CornerRadius="8" Padding="12,8" VerticalAlignment="Center"><TextBlock Text="{Binding SelectionText}" Foreground="{StaticResource Accent}" FontSize="12"/></Border>
   </Grid>
   <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,0">
     <WrapPanel>
      <Button Style="{StaticResource SmallButton}" Content="All keys" Tag="all" Click="SelectKeys"/>
      <Button Style="{StaticResource SmallButton}" Content="Typing keys" Tag="typing" Click="SelectKeys"/>
      <Button Style="{StaticResource SmallButton}" Content="Letters" Tag="letters" Click="SelectKeys"/>
      <Button Style="{StaticResource SmallButton}" Content="WASD" Tag="wasd" Click="SelectKeys"/>
      <Button Style="{StaticResource SmallButton}" Content="Arrows" Tag="arrows" Click="SelectKeys"/>
      <Button Style="{StaticResource SmallButton}" Content="NumPad" Tag="numpad" Click="SelectKeys"/>
      <Button Style="{StaticResource SmallButton}" Content="Clear selection" Tag="none" Click="SelectKeys" Background="White"/>
     </WrapPanel>
     <Border Background="#F5F6FB" BorderBrush="#E6E8F1" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,6,0,0">
      <Viewbox Stretch="Uniform" MaxHeight="260"><Canvas x:Name="KeyboardCanvas" Width="1012" Height="276"/></Viewbox>
     </Border>
     <TextBlock Text="Purple: selected · pink: excluded · dot: saved assignment. Click without Ctrl. Main and NumPad Enter share one code." Foreground="{StaticResource Muted}" FontSize="10" Margin="2,8,0,18"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="Assignments" FontSize="16" FontWeight="SemiBold"/>
       <Button Content="+ Assignment" Click="NewAssignment" Margin="0,8,0,8" FontSize="12"/>
       <WrapPanel Margin="0,0,0,4"><Button x:Name="ImportKeyboardButton" Content="Import" Click="ImportKeyboard" Style="{StaticResource SmallButton}" ToolTip="Add from JSON. Matching IDs are updated; other events are preserved."/><Button x:Name="ExportKeyboardButton" Content="Export ▾" Click="ExportKeyboard" Style="{StaticResource SmallButton}"><Button.ContextMenu><ContextMenu><MenuItem Header="All saved assignments" Click="ExportAllKeyboard"/><MenuItem Header="Selected saved assignment" Click="ExportSelectedKeyboard"/></ContextMenu></Button.ContextMenu></Button></WrapPanel>
       <Button x:Name="AiInstructionsButton" Content="AI instructions" Click="ShowAiInstructions" Background="White" FontSize="11" Margin="0,0,0,8"/>
       <ListBox x:Name="Assignments" ItemsSource="{Binding Groups}" SelectedValuePath="Id" SelectedValue="{Binding SelectedId, Mode=OneWay}" SelectionChanged="AssignmentSelected" MaxHeight="260"><ListBox.ItemTemplate><DataTemplate><StackPanel>
        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding KeysText}" FontSize="10" Foreground="{StaticResource Accent}" Margin="0,4,0,0"/><TextBlock Text="{Binding Scope}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        <TextBlock FontSize="10" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Disabled"/><Setter Property="Foreground" Value="#A47781"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="Text" Value="Enabled"/><Setter Property="Foreground" Value="#49836A"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
       <Button Content="Duplicate" Click="DuplicateAssignment" Background="White" FontSize="11" Margin="0,8,0,0"/>
      </StackPanel>
      <StackPanel x:Name="AssignmentEditor" Grid.Column="2">
       <TextBlock Text="{Binding EditStatus}" FontSize="10" Foreground="{StaticResource Muted}"/>
       <Grid Margin="0,5,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FontWeight="SemiBold"/><CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding Draft.Enabled}" FontSize="11" Margin="10,0,0,0"/>
       </Grid>
       <WrapPanel><Button Style="{StaticResource SmallButton}" Content="Feedback · 150 ms" Tag="feedback" Click="ChoosePreset"/><Button Style="{StaticResource SmallButton}" Content="Typewriter · 120 ms" Tag="typewriter" Click="ChoosePreset"/><Button Style="{StaticResource SmallButton}" Content="Pulse" Tag="pulse" Click="ChoosePreset"/></WrapPanel>
       <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="Effect" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Effects}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Draft.Action}"/>
         <Grid Margin="0,12,0,5"><TextBlock Text="Intensity" FontSize="12"/><TextBlock Text="{Binding Draft.IntensityText}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Grid>
         <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Draft.Intensity}"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Duration · ms" Style="{StaticResource Label}"/><TextBox Text="{Binding Draft.DurationMilliseconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Cooldown · ms" Style="{StaticResource Label}"/><TextBox Text="{Binding Draft.CooldownMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ToolTip="Minimum interval between effects. Presses during cooldown are skipped."/></StackPanel>
         </Grid>
         <TextBlock Text="Pulse interval · ms" Style="{StaticResource Label}" Visibility="{Binding Draft.ShowPulse, Converter={StaticResource Visible}}"/><TextBox Text="{Binding Draft.PulseMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Visibility="{Binding Draft.ShowPulse, Converter={StaticResource Visible}}"/>
         <controls:EffectPreview x:Name="KeyboardGraph" Height="80" Margin="0,10,0,0" Kind="{Binding Draft.Action}" Duration="{Binding Draft.DurationSeconds}" Intensity="{Binding Draft.Intensity}" Pulse="{Binding Draft.PulseMs}"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <TextBlock Text="Application" Style="{StaticResource Label}"/><ComboBox x:Name="KeyboardApplication" ItemsSource="{Binding Applications}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Draft.Process, Mode=OneWay}" DropDownOpened="RefreshApps" SelectionChanged="AppSelected"/>
         <TextBlock Text="Window title contains" Style="{StaticResource Label}"/><TextBox Text="{Binding Draft.WindowTitleContains, UpdateSourceTrigger=PropertyChanged}" ToolTip="Leave blank for any window. For example, a game or document title."/>
         <TextBlock Text="Toy" Style="{StaticResource Label}"/><ComboBox x:Name="KeyboardTarget" ItemsSource="{Binding Targets}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Draft.ToyId, Mode=OneWay}" SelectionChanged="TargetSelected"/>
         <TextBlock Text="Priority" Style="{StaticResource Label}"/><TextBox Text="{Binding Draft.Priority, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
         <TextBlock Text="Equal priority: application, window filter, then smaller key group." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
        </StackPanel>
       </Grid>
       <Border Background="#F3F0FD" CornerRadius="8" Padding="10" Margin="0,10,0,8"><TextBlock Text="{Binding Summary}" FontSize="11"/></Border>
       <TextBlock Text="Selecting keys edits the draft. Save the assignment to apply it. Short effects require direct Bluetooth. Assignments replace regular key-down rules for selected keys." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
      </StackPanel>
     </Grid>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <WrapPanel><Button x:Name="SaveAssignmentButton" Content="Save assignment" Click="SaveAssignment" Background="{StaticResource Accent}" Foreground="White" FontSize="12"/><Button Content="Test effect" Click="TestAssignment" FontSize="12"/></WrapPanel>
    <Button Grid.Column="1" Content="Delete assignment" Click="DeleteAssignment" Background="#FFF0F1" Foreground="#B13C50" BorderBrush="#F1D6DB" FontSize="11" Margin="0"/>
   </Grid>
  </Grid>
 </Border>
</UserControl>
