<Window x:Class="LovenseIntegrator.Desktop.EventPickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Choose event" Width="720" Height="600" MinWidth="600" MinHeight="460"
 WindowStartupLocation="CenterOwner" Background="#F5F6FA" FontFamily="Segoe UI" FontSize="14">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="What should happen?" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Choose an event. Its settings will appear in the rule." Foreground="{StaticResource Muted}" Margin="0,6,0,18"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ComboBox x:Name="Category" SelectionChanged="FilterChanged"/>
   <TextBox x:Name="Search" Grid.Column="2" TextChanged="SearchChanged" ToolTip="Search names and descriptions"/>
   <TextBlock Grid.Column="2" Text="Search events…" IsHitTestVisible="False" Foreground="#949AAD" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </Grid>
  <ListBox x:Name="Options" Grid.Row="2" SelectionChanged="OptionChanged" MouseDoubleClick="ChooseOnDoubleClick">
   <ListBox.ItemTemplate><DataTemplate>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Background="#EEEAFB" CornerRadius="10" Width="32" Height="32" VerticalAlignment="Top"><TextBlock Text="{Binding Marker}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/></Border>
     <StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Help}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
    </Grid>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="Count" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Cancel" IsCancel="True"/><Button x:Name="ChooseButton" Content="Choose event" Click="Choose" IsEnabled="False" Background="{StaticResource Accent}" Foreground="White"/></StackPanel>
  </Grid>
 </Grid>
</Window>
