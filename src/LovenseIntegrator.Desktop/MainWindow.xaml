<Window x:Class="LovenseIntegrator.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:loc="clr-namespace:LovenseIntegrator.Desktop.Localization"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:LovenseIntegrator.Desktop.ViewModels"
 xmlns:controls="clr-namespace:LovenseIntegrator.Desktop.Controls"
 xmlns:local="clr-namespace:LovenseIntegrator.Desktop"
 Title="Lovense Integrator" Width="1360" Height="900" MinWidth="1120" MinHeight="720"
 FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}"
 WindowStartupLocation="CenterScreen" Background="#F5F6FA" Language="en-US">
 <Window.Resources><vm:RuleSummaryConverter x:Key="RuleSummary"/><vm:ActionCheckedConverter x:Key="ActionChecked"/></Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Lovense Integrator" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr Text='Choose a trigger. Attach an effect.'}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="{Binding RunStatus}" HorizontalAlignment="Right" FontSize="12"/><CheckBox Content="{loc:Tr Text='Observe without actions'}" IsChecked="{Binding ObserveOnly}" FontSize="12" Margin="0,5,0,0" ToolTip="{loc:Tr Text='Automatic triggers appear in the log. Manual controls and action testing remain available.'}"/></StackPanel>
    <Button Content="{Binding RunLabel}" Click="Toggle" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" Margin="0"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <TabControl x:Name="Modes" BorderThickness="0" Background="Transparent">
    <TabItem x:Name="KeyboardTab" Header="{loc:Tr Text='  Keyboard  '}"><local:KeyboardModeView x:Name="KeyboardMode"/></TabItem>
    <TabItem x:Name="MouseTab" Header="{loc:Tr Text='  Mouse  '}"><local:MouseModeView x:Name="MouseMode"/></TabItem>
    <TabItem x:Name="ScreenTab" Header="{loc:Tr Text='  Screen  '}"><Border Style="{StaticResource Card}" Margin="0,10,0,0"><local:ScreenModeView x:Name="ScreenMode"/></Border></TabItem>
    <TabItem x:Name="RulesTab" Header="{loc:Tr Text='  Other events  '}">
     <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10"><TextBlock Text="{loc:Tr Text='Assignments'}" FontSize="19" FontWeight="SemiBold"/><Button Content="{loc:Tr Text='+ Assignment'}" Click="NewRule" Margin="0,10,0,0"/></StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding AutomationRules}" SelectedItem="{Binding SelectedRule}"><ListBox.ItemTemplate><DataTemplate><StackPanel>
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="{Binding Converter={StaticResource RuleSummary}}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" MaxHeight="62" TextTrimming="CharacterEllipsis"/>
         <TextBlock FontSize="10" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{loc:Tr Text='Paused'}"/><Setter Property="Foreground" Value="#949AAD"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="Text" Value="{loc:Tr Text='Enabled'}"/><Setter Property="Foreground" Value="#49836A"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
        <Expander Grid.Row="2" Header="{loc:Tr Text='Ready-made recipes'}" Margin="0,12,0,12" FontSize="12"><ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Recipes}"><ItemsControl.ItemTemplate><DataTemplate>
         <Button Click="Recipe" Tag="{Binding}" HorizontalContentAlignment="Left" Margin="0,5,4,0" Padding="10,8"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></Button>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Expander>
        <WrapPanel Grid.Row="3"><Button Content="{loc:Tr Text='Import'}" Click="Import" FontSize="12"/><Button Content="{loc:Tr Text='Export'}" Click="Export" FontSize="12" Margin="0"/></WrapPanel>
       </Grid>
       <controls:AssignmentEditorView x:Name="RuleAssignmentEditor" Grid.Column="2" SaveRequested="SaveRule" TestRequested="TestRule" DeleteRequested="DeleteRule"><controls:AssignmentEditorView.TriggerContent><StackPanel><Button Click="PickEvent" Margin="0" Padding="12" HorizontalContentAlignment="Left" Background="White" BorderBrush="#CFC6EC"><StackPanel><TextBlock Text="{Binding Draft.EventCategory}" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Draft.EventTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"/><TextBlock Text="{loc:Tr Text='Choose another event →'}" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
           <TextBlock Text="{Binding Draft.EventHelp}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
           <StackPanel Visibility="{Binding Draft.ShowScreen, Converter={StaticResource Visible}}"><ComboBox ItemsSource="{Binding Draft.ScreenEventsList}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Draft.ScreenEventId}"/></StackPanel><StackPanel x:Name="KeyboardSettings" Visibility="{Binding Draft.ShowKeyboard, Converter={StaticResource Visible}}">
            <TextBlock Text="{loc:Tr Text='Keys'}" Style="{StaticResource Label}"/>
            <ItemsControl ItemsSource="{Binding Draft.KeyCaps}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#DCD4F4" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,5,5"><TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="12"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <WrapPanel Margin="0,5,0,0"><Button x:Name="CaptureButton" Content="{loc:Tr Text='Record'}" Click="Capture" FontSize="12"/><Button Content="{loc:Tr Text='Any'}" Click="AnyKey" FontSize="12" Margin="0" Visibility="{Binding Draft.AllowAnyKey, Converter={StaticResource Visible}}"/></WrapPanel>
           </StackPanel>
           <StackPanel Visibility="{Binding Draft.ShowMouse, Converter={StaticResource Visible}}"><TextBlock Text="{loc:Tr Text='Mouse button'}" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding MouseButtons}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Draft.Keys}"/></StackPanel>
           <StackPanel Visibility="{Binding Draft.ShowWheel, Converter={StaticResource Visible}}"><TextBlock Text="{loc:Tr Text='Direction'}" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding WheelDirections}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Draft.Keys}"/></StackPanel>
           <StackPanel x:Name="ThresholdSettings" Visibility="{Binding Draft.ShowThreshold, Converter={StaticResource Visible}}"><TextBlock Text="{Binding Draft.ThresholdLabel}" Style="{StaticResource Label}"/><TextBox x:Name="ThresholdInput" Text="{Binding Draft.ThresholdDisplay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
           <StackPanel x:Name="WindowSettings" Visibility="{Binding Draft.ShowWindow, Converter={StaticResource Visible}}"><TextBlock Text="{loc:Tr Text='Measurement window · seconds'}" Style="{StaticResource Label}"/><TextBox Text="{Binding Draft.WindowSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
<Expander Header="{loc:Tr Text='Key codes'}" Margin="0,10,0,0" Visibility="{Binding Draft.ShowKeyDetails, Converter={StaticResource Visible}}"><StackPanel><TextBlock Text="{loc:Tr Text='Key codes · separated by + or comma'}" Style="{StaticResource Label}"/><TextBox x:Name="KeysInput" Text="{Binding Draft.Keys, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Expander></StackPanel></controls:AssignmentEditorView.TriggerContent></controls:AssignmentEditorView>
      </Grid>
     </Border>
    </TabItem>
    <TabItem Header="{loc:Tr Text='  Log  '}"><Border Style="{StaticResource Card}" Margin="0,10,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,16"><TextBlock Text="{loc:Tr Text='Triggers and connection'}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr Text='Last 100 entries. Observation mode checks rules without automatic actions.'}" Foreground="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12"/></StackPanel>
     <ListBox Grid.Row="1" ItemsSource="{Binding Journal}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12"/></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid></Border></TabItem>

    <TabItem x:Name="DevicesTab" Header="{loc:Tr Text='  Devices  '}"><Border Style="{StaticResource Card}" Margin="0,10,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="620" HorizontalAlignment="Left" MinWidth="460"><TextBlock Text="{loc:Tr Text='Devices'}" FontSize="19" FontWeight="SemiBold"/>
     <TextBlock Text="{loc:Tr Text='Connection'}" Style="{StaticResource Label}"/>
     <ComboBox ItemsSource="{Binding Transports}" SelectedIndex="{Binding TransportIndex}" FontSize="12"/>
     <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TransportIndex}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{loc:Tr Text='Local API URL'}" Style="{StaticResource Label}"/><TextBox Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" FontSize="12"/>
     </StackPanel>
     <Button Content="{loc:Tr Text='Connect / refresh'}" Click="Discover" Margin="0,10,0,0" FontSize="12"/>
     <ProgressBar Height="3" IsIndeterminate="{Binding Busy}" Margin="0,10,0,8"/>
     <TextBlock Text="{Binding ConnectionName}" Foreground="{StaticResource Muted}" FontSize="11"/>
     <ListBox x:Name="DeviceList" ItemsSource="{Binding Toys}" SelectedItem="{Binding SelectedToy}" MinHeight="80" Margin="-8,10,-6,0" FontSize="12"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
</StackPanel></ScrollViewer></Border></TabItem>
    <TabItem x:Name="ManualTab" Header="{loc:Tr Text='  Manual control  '}"><Border Style="{StaticResource Card}" Margin="0,10,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="620" HorizontalAlignment="Left" MinWidth="460"><TextBlock Text="{loc:Tr Text='Manual control'}" FontSize="17" FontWeight="SemiBold"/>
     <ComboBox x:Name="ManualTarget" ItemsSource="{Binding Toys}" SelectedItem="{Binding SelectedToy}" Margin="0,14,0,8"/><TextBlock Text="{loc:Tr Text='For the selected toy'}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
     <Grid Margin="0,18,0,8"><TextBlock Text="{loc:Tr Text='Intensity'}"/><TextBlock Text="{Binding ManualIntensity, StringFormat={}{0}/20}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/></Grid>
     <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ManualIntensity}"/>
     <TextBlock Text="{loc:Tr Text='Duration · seconds'}" Style="{StaticResource Label}"/><TextBox x:Name="ManualSeconds" Text="{Binding ManualDuration, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
     <WrapPanel Margin="0,12,0,0"><Button Content="{loc:Tr Text='Run'}" Click="Manual" FontSize="12"/><Button Content="{loc:Tr Text='Pulse'}" Click="Pulse" FontSize="12" Margin="0"/></WrapPanel>
</StackPanel></ScrollViewer></Border></TabItem>
    <TabItem x:Name="UpdatesTab" Header="{Binding DataContext.TabTitle, ElementName=UpdatesPanel}">
     <Border x:Name="UpdatesPanel" Style="{StaticResource Card}" Margin="0,10,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="640" HorizontalAlignment="Left">
       <TextBlock Text="{loc:Tr Text='App updates'}" FontSize="24" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding VersionLabel}" Foreground="{StaticResource Muted}" Margin="0,8,0,24"/>
       <CheckBox Content="{loc:Tr Text='Automatically check and download updates'}" IsChecked="{Binding Automatic}" Margin="0,0,0,12"/>
       <TextBlock Text="{loc:Tr Text='Stable releases are checked at startup and every 6 hours. Downloads happen in the background. A downloaded update is installed the next time you start the app.'}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
       <TextBlock Text="{loc:Tr Text='Your rules and profiles are preserved. Restarting stops active effects and disconnects devices. Rules remain paused after the update.'}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,24"/>
       <TextBlock x:Name="UpdateStatus" Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold"/>
       <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="6" Margin="0,16,0,20"/>
       <WrapPanel>
        <Button x:Name="CheckUpdatesButton" Content="{loc:Tr Text='Check for updates'}" Click="CheckUpdates" IsEnabled="{Binding CanCheck}"/>
        <Button x:Name="RestartUpdateButton" Content="{loc:Tr Text='Restart to update'}" Click="RestartToUpdate" IsEnabled="{Binding CanRestart}" Background="{StaticResource Accent}" Foreground="White"/>
        <Button Content="{loc:Tr Text='Release notes ↗'}" Click="OpenReleases"/>
       </WrapPanel>
       <TextBlock Text="{Binding PreferenceError}" TextWrapping="Wrap" Foreground="#B13C50" Margin="0,12,0,0"/>
       <TextBlock Text="{loc:Tr Text='Source: github.com/timurchak/LovenseIntegrator'}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,24,0,0"/>
      </StackPanel></ScrollViewer>
     </Border>
    </TabItem>
    <TabItem x:Name="SettingsTab" Header="{loc:Tr Text='  Settings  '}">
     <Border Style="{StaticResource Card}" Margin="0,10,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="640" HorizontalAlignment="Left">
       <TextBlock Text="{loc:Tr Text='App language'}" FontSize="24" FontWeight="SemiBold"/>
       <TextBlock Text="{loc:Tr Text='Choose the interface language. Changes take effect the next time you start the app.'}" Margin="0,12,0,20" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
       <TextBlock Text="{loc:Tr Text='Language'}" Style="{StaticResource Label}"/>
       <ComboBox x:Name="LanguageSelector" Width="240" HorizontalAlignment="Left" SelectedValuePath="Tag" AutomationProperties.Name="Interface language">
        <ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Русский" Tag="ru"/>
       </ComboBox>
       <Button x:Name="SaveLanguageButton" Content="{loc:Tr Text='Save language'}" Click="SaveLanguage" HorizontalAlignment="Left" Margin="0,16,0,0"/>
       <TextBlock x:Name="LanguageSaveStatus" Margin="0,12,0,0" TextWrapping="Wrap"/>
       <TextBlock Text="{loc:Tr Text='Your rule names, key codes and imported files are not translated.'}" Margin="0,24,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
      </StackPanel></ScrollViewer>
     </Border>
    </TabItem>
   </TabControl>
  </Grid>
  <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="12" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="{Binding Status}" FontSize="12"/><TextBlock Text="{Binding HotkeyStatus}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
   <Button Grid.Column="1" Content="{loc:Tr Text='STOP ALL'}" Click="StopAll" Background="#BE3E53" Foreground="White" BorderThickness="0" Margin="0"/>
  </Grid></Border>
 </Grid>
</Window>
