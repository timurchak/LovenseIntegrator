<Window x:Class="LovenseIntegrator.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:LovenseIntegrator.Desktop.ViewModels"
 xmlns:controls="clr-namespace:LovenseIntegrator.Desktop.Controls"
 xmlns:local="clr-namespace:LovenseIntegrator.Desktop"
 Title="Lovense Integrator" Width="1360" Height="900" MinWidth="1120" MinHeight="720"
 FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}"
 WindowStartupLocation="CenterScreen" Background="#F5F6FA" Language="en-US">
 <Window.Resources><vm:RuleSummaryConverter x:Key="RuleSummary"/><vm:ActionCheckedConverter x:Key="ActionChecked"/></Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Lovense Integrator" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Event → action. Set your own rhythm." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="{Binding RunStatus}" HorizontalAlignment="Right" FontSize="12"/><CheckBox Content="Observe without actions" IsChecked="{Binding ObserveOnly}" FontSize="12" Margin="0,5,0,0" ToolTip="Automatic triggers appear in the log. Manual controls and action testing remain available."/></StackPanel>
    <Button Content="{Binding RunLabel}" Click="Toggle" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" Margin="0"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,6,0">
     <TextBlock Text="Devices" FontSize="19" FontWeight="SemiBold"/>
     <TextBlock Text="Connection" Style="{StaticResource Label}"/>
     <ComboBox ItemsSource="{Binding Transports}" SelectedIndex="{Binding TransportIndex}" FontSize="12"/>
     <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TransportIndex}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="Local API URL" Style="{StaticResource Label}"/><TextBox Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" FontSize="12"/>
     </StackPanel>
     <Button Content="Connect / refresh" Click="Discover" Margin="0,10,0,0" FontSize="12"/>
     <ProgressBar Height="3" IsIndeterminate="{Binding Busy}" Margin="0,10,0,8"/>
     <TextBlock Text="{Binding ConnectionName}" Foreground="{StaticResource Muted}" FontSize="11"/>
     <ListBox ItemsSource="{Binding Toys}" SelectedItem="{Binding SelectedToy}" MinHeight="80" Margin="-8,10,-6,0" FontSize="12"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
     <Border Height="1" Background="#E4E6EE" Margin="0,16,0,18"/>
     <TextBlock Text="Manual control" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="For the selected toy" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
     <Grid Margin="0,18,0,8"><TextBlock Text="Intensity"/><TextBlock Text="{Binding ManualIntensity, StringFormat={}{0}/20}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/></Grid>
     <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ManualIntensity}"/>
     <TextBlock Text="Duration · seconds" Style="{StaticResource Label}"/><TextBox x:Name="ManualSeconds" Text="{Binding ManualDuration, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
     <WrapPanel Margin="0,12,0,0"><Button Content="Run" Click="Manual" FontSize="12"/><Button Content="Pulse" Click="Pulse" FontSize="12" Margin="0"/></WrapPanel>
     <Border Background="#F2EEFD" CornerRadius="8" Padding="11" Margin="0,20,0,0"><TextBlock Text="Start in demo mode to see triggers without a toy. Then connect a device and enable rules." Foreground="#65568B" FontSize="11"/></Border>
    </StackPanel></ScrollViewer>
   </Border>
   <TabControl x:Name="Modes" Grid.Column="2" BorderThickness="0" Background="Transparent">
    <TabItem x:Name="KeyboardTab" Header="  Keyboard  "><local:KeyboardModeView x:Name="KeyboardMode"/></TabItem>
    <TabItem x:Name="MouseTab" Header="  Mouse  "><local:MouseModeView x:Name="MouseMode"/></TabItem>
    <TabItem x:Name="RulesTab" Header="  Other events  ">
     <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10"><TextBlock Text="My rules" FontSize="19" FontWeight="SemiBold"/><Button Content="+ New rule" Click="NewRule" Margin="0,10,0,0"/></StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding AutomationRules}" SelectedItem="{Binding SelectedRule}"><ListBox.ItemTemplate><DataTemplate><StackPanel>
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="{Binding Converter={StaticResource RuleSummary}}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" MaxHeight="62" TextTrimming="CharacterEllipsis"/>
         <TextBlock FontSize="10" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Paused"/><Setter Property="Foreground" Value="#949AAD"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="Text" Value="Enabled"/><Setter Property="Foreground" Value="#49836A"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
        <Expander Grid.Row="2" Header="Ready-made recipes" Margin="0,12,0,12" FontSize="12"><ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Recipes}"><ItemsControl.ItemTemplate><DataTemplate>
         <Button Click="Recipe" Tag="{Binding}" HorizontalContentAlignment="Left" Margin="0,5,4,0" Padding="10,8"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></Button>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Expander>
        <WrapPanel Grid.Row="3"><Button Content="Import" Click="Import" FontSize="12"/><Button Content="Export" Click="Export" FontSize="12" Margin="0"/></WrapPanel>
       </Grid>
       <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="RuleName" Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" FontSize="17" FontWeight="SemiBold" ToolTip="Rule name"/>
         <CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding Draft.Enabled}" Margin="12,0,0,0" FontSize="12"/>
        </Grid>
        <Border Grid.Row="1" Background="#F2EEFD" CornerRadius="10" Padding="12" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center"><TextBlock Text="PREVIEW" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding Draft.Summary}" FontSize="13" Margin="0,5,0,0"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Effect over time · preview" FontSize="10" Foreground="{StaticResource Muted}"/><controls:EffectPreview x:Name="EffectGraph" Height="85" Kind="{Binding Draft.Action}" Intensity="{Binding Draft.Intensity}" Duration="{Binding Draft.DurationSeconds}" Pulse="{Binding Draft.PulseMs}"/></StackPanel>
        </Grid></Border>
        <ScrollViewer x:Name="EditorScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <Grid x:Name="Editor" Margin="0,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
           <TextBlock Text="01  When" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
           <Button Click="PickEvent" Margin="0" Padding="12" HorizontalContentAlignment="Left" Background="White" BorderBrush="#CFC6EC"><StackPanel><TextBlock Text="{Binding Draft.EventCategory}" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Draft.EventTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"/><TextBlock Text="Choose another event →" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
           <TextBlock Text="{Binding Draft.EventHelp}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
           <StackPanel x:Name="KeyboardSettings" Visibility="{Binding Draft.ShowKeyboard, Converter={StaticResource Visible}}">
            <TextBlock Text="Keys" Style="{StaticResource Label}"/>
            <ItemsControl ItemsSource="{Binding Draft.KeyCaps}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#DCD4F4" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,5,5"><TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="12"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <WrapPanel Margin="0,5,0,0"><Button x:Name="CaptureButton" Content="Record" Click="Capture" FontSize="12"/><Button Content="Any" Click="AnyKey" FontSize="12" Margin="0" Visibility="{Binding Draft.AllowAnyKey, Converter={StaticResource Visible}}"/></WrapPanel>
           </StackPanel>
           <StackPanel Visibility="{Binding Draft.ShowMouse, Converter={StaticResource Visible}}"><TextBlock Text="Mouse button" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding MouseButtons}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Draft.Keys}"/></StackPanel>
           <StackPanel Visibility="{Binding Draft.ShowWheel, Converter={StaticResource Visible}}"><TextBlock Text="Direction" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding WheelDirections}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Draft.Keys}"/></StackPanel>
           <StackPanel x:Name="ThresholdSettings" Visibility="{Binding Draft.ShowThreshold, Converter={StaticResource Visible}}"><TextBlock Text="{Binding Draft.ThresholdLabel}" Style="{StaticResource Label}"/><TextBox x:Name="ThresholdInput" Text="{Binding Draft.ThresholdDisplay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
           <StackPanel x:Name="WindowSettings" Visibility="{Binding Draft.ShowWindow, Converter={StaticResource Visible}}"><TextBlock Text="Measurement window · seconds" Style="{StaticResource Label}"/><TextBox Text="{Binding Draft.WindowSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
           <TextBlock Text="02  Where" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,24,0,10"/>
           <ComboBox x:Name="ApplicationSelector" ItemsSource="{Binding ApplicationChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Draft.Process, Mode=OneWay}" SelectionChanged="ApplicationSelected" DropDownOpened="RefreshApplications"/>
           <TextBlock Text="The rule only applies while this application is active." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
           <TextBlock Text="03  Action" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
           <UniformGrid Columns="2">
            <RadioButton Style="{StaticResource EffectChoice}" Content="Vibration" Tag="Vibrate" GroupName="Effect" FontSize="12" Margin="0,0,6,6" IsChecked="{Binding Draft.Action, Converter={StaticResource ActionChecked}, ConverterParameter=Vibrate, Mode=OneWay}" Click="EffectSelected"/>
            <RadioButton Style="{StaticResource EffectChoice}" Content="Pulse" Tag="Pulse" GroupName="Effect" FontSize="12" IsChecked="{Binding Draft.Action, Converter={StaticResource ActionChecked}, ConverterParameter=Pulse, Mode=OneWay}" Click="EffectSelected"/>
            <RadioButton Style="{StaticResource EffectChoice}" Content="Speed-based" Tag="RateMapped" GroupName="Effect" FontSize="12" Margin="0,0,6,6" IsEnabled="{Binding Draft.SupportsSpeedMapping}" ToolTip="For fast and slow typing events" IsChecked="{Binding Draft.Action, Converter={StaticResource ActionChecked}, ConverterParameter=RateMapped, Mode=OneWay}" Click="EffectSelected"/>
            <RadioButton Style="{StaticResource EffectChoice}" Content="Stop" Tag="Stop" GroupName="Effect" FontSize="12" IsChecked="{Binding Draft.Action, Converter={StaticResource ActionChecked}, ConverterParameter=Stop, Mode=OneWay}" Click="EffectSelected"/>
           </UniformGrid>
           <TextBlock Text="Toy" Style="{StaticResource Label}"/><ComboBox x:Name="TargetSelector" ItemsSource="{Binding Targets}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Draft.ToyId}"/>
           <StackPanel x:Name="EffectSettings" Visibility="{Binding Draft.ShowEffect, Converter={StaticResource Visible}}">
            <Grid Margin="0,16,0,8"><TextBlock Text="Intensity"/><TextBlock Text="{Binding Draft.IntensityText}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Grid>
            <Slider x:Name="IntensitySlider" Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Draft.Intensity}"/>
            <WrapPanel Margin="0,8,0,0"><Button Content="Soft" Tag="3" Click="IntensityPreset" FontSize="10" Padding="8,5"/><Button Content="Medium" Tag="7" Click="IntensityPreset" FontSize="10" Padding="8,5"/><Button Content="Strong" Tag="12" Click="IntensityPreset" FontSize="10" Padding="8,5" Margin="0"/></WrapPanel>
            <Grid Margin="0,16,0,8"><TextBlock Text="Duration"/><TextBlock Text="{Binding Draft.DurationText}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Grid>
            <Slider x:Name="DurationSlider" Minimum="0.1" Maximum="{Binding Draft.DurationSliderMaximum}" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Draft.DurationSeconds}"/>
            <WrapPanel Margin="0,8,0,0"><Button Content="100 ms" Tag="0.1" Click="DurationPreset" FontSize="10" Padding="9,5"/><Button Content="150 ms" Tag="0.15" Click="DurationPreset" FontSize="10" Padding="9,5"/><Button Content="250 ms" Tag="0.25" Click="DurationPreset" FontSize="10" Padding="9,5" Margin="0"/></WrapPanel>
            <TextBlock Text="Effects up to 1 s require direct Bluetooth. Rapid pulses may merge: adjust cooldown between effects." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
            <WrapPanel Margin="0,8,0,0"><Button Content="2 s" Tag="2" Click="DurationPreset" FontSize="10" Padding="9,5"/><Button Content="3 s" Tag="3" Click="DurationPreset" FontSize="10" Padding="9,5"/><Button Content="5 s" Tag="5" Click="DurationPreset" FontSize="10" Padding="9,5"/><Button Content="10 s" Tag="10" Click="DurationPreset" FontSize="10" Padding="9,5" Margin="0"/></WrapPanel>
            <StackPanel x:Name="PulseSettings" Visibility="{Binding Draft.ShowPulse, Converter={StaticResource Visible}}"><TextBlock Text="{Binding Draft.PulseText}" Style="{StaticResource Label}"/><Slider Minimum="0.15" Maximum="10" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Draft.PulseSeconds}"/></StackPanel>
            <TextBlock Text="On trigger: speed / threshold × intensity, capped at 20. The preview shows the level at the threshold." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,10,0,0" Visibility="{Binding Draft.ShowMapping, Converter={StaticResource Visible}}"/>
           </StackPanel>
          </StackPanel>
          <Expander x:Name="AdvancedSettings" Grid.Row="1" Grid.ColumnSpan="3" Header="Advanced settings" FontSize="12" Margin="0,20,0,12"><StackPanel>
           <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Minimum interval · seconds" Style="{StaticResource Label}"/><TextBox Text="{Binding Draft.CooldownSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Priority · higher wins" Style="{StaticResource Label}"/><TextBox Text="{Binding Draft.Priority, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
           </Grid>
           <TextBlock Text="When several rules match, the highest-priority rule wins." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
           <StackPanel Visibility="{Binding Draft.ShowKeyDetails, Converter={StaticResource Visible}}"><TextBlock Text="Key codes · separated by + or comma" Style="{StaticResource Label}"/><TextBox x:Name="KeysInput" Text="{Binding Draft.Keys, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
           <TextBlock Text="Exact duration · seconds (0.1–300)" Style="{StaticResource Label}"/><TextBox Text="{Binding Draft.DurationSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
          </StackPanel></Expander>
         </Grid>
        </ScrollViewer>
        <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <WrapPanel><Button Content="Save" Click="SaveRule" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"/><Button Content="Test action" Click="TestRule" FontSize="12"/></WrapPanel>
         <Button Grid.Column="1" Content="Delete" Click="DeleteRule" Background="#FFF0F1" Foreground="#B13C50" BorderBrush="#F1D6DB" Margin="0" FontSize="12"/>
        </Grid>
       </Grid>
      </Grid>
     </Border>
    </TabItem>
    <TabItem Header="  Log  "><Border Style="{StaticResource Card}" Margin="0,10,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,16"><TextBlock Text="Triggers and connection" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Last 100 entries. Observation mode checks rules without automatic actions." Foreground="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12"/></StackPanel>
     <ListBox Grid.Row="1" ItemsSource="{Binding Journal}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12"/></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid></Border></TabItem>
    <TabItem Header="  Screen · later  "><Border Style="{StaticResource Card}" Margin="0,10,0,0"><StackPanel><TextBlock Text="Screen region recognition" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Next stage: region selection, template matching, color and OCR. Results will trigger the same rules and actions." Margin="0,16,0,0" Foreground="{StaticResource Muted}"/><TextBlock Text="Screen capture is not running." Margin="0,16,0,0"/></StackPanel></Border></TabItem>
   </TabControl>
  </Grid>
  <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="12" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="{Binding Status}" FontSize="12"/><TextBlock Text="{Binding HotkeyStatus}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
   <Button Grid.Column="1" Content="STOP ALL" Click="StopAll" Background="#BE3E53" Foreground="White" BorderThickness="0" Margin="0"/>
  </Grid></Border>
 </Grid>
</Window>
