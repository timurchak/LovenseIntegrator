<UserControl x:Class="LovenseIntegrator.Desktop.ScreenModeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:LovenseIntegrator.Desktop.Localization" xmlns:controls="clr-namespace:LovenseIntegrator.Desktop.Controls">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="4,0,12,8">
   <TextBlock Text="{loc:Tr Text='Screen · World of Warcraft'}" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="{loc:Tr Text='Choose game events by meaning. The addon sends events; your saved assignments choose the effects.'}" Margin="0,8,0,16" TextWrapping="Wrap"/>
   <Border Background="#F2EEFD" CornerRadius="10" Padding="14">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,14,0">
      <TextBlock Text="{loc:Tr Text='1. Read the addon signal'}" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="{loc:Tr Text='Install WowScreenEvents, then /wse show. Defaults: top left, 4 px cells (32 × 32 px block). Use windowed or borderless WoW.'}" Margin="0,8,0,8" TextWrapping="Wrap"/>
      <WrapPanel x:Name="RegionInputs" IsEnabled="{Binding CanConfigure}">
       <StackPanel Margin="0,0,12,8"><TextBlock Text="X · px"/><TextBox Width="72" Text="{Binding Region.X, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
       <StackPanel Margin="0,0,12,8"><TextBlock Text="Y · px"/><TextBox Width="72" Text="{Binding Region.Y, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
       <StackPanel Margin="0,0,12,8"><TextBlock Text="{loc:Tr Text='Cell · px'}"/><TextBox Width="72" Text="{Binding Region.CellSize, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
      </WrapPanel>
      <Button x:Name="MonitorButton" Content="{Binding MonitorLabel}" IsEnabled="{Binding CanToggle}" Click="Monitor" HorizontalAlignment="Left"/>
      <TextBlock x:Name="SignalStatus" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold"/>
     </StackPanel>
     <StackPanel Grid.Column="1"><Border Background="#17152B" Width="104" Height="104" Padding="4"><Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border><TextBlock Text="{loc:Tr Text='Live preview'}" TextAlignment="Center" FontSize="11" Margin="0,5,0,0"/></StackPanel>
    </Grid>
   </Border>
   <TextBlock Text="{loc:Tr Text='Reading alone never activates toys. Enable rules when ready. Leaving WoW or losing a live signal pauses Screen rules; resume manually.'}" TextWrapping="Wrap" Margin="0,10,0,16" Foreground="#665E77"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="{loc:Tr Text='Saved assignments'}" FontWeight="SemiBold" FontSize="16"/>
     <ListBox x:Name="AssignmentList" ItemsSource="{Binding Assignments}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" Height="220" Margin="0,10,0,8"/>
     <WrapPanel><Button Content="{loc:Tr Text='New assignment'}" Click="NewAssignment"/><Button Content="{loc:Tr Text='Delete'}" Click="DeleteAssignment"/></WrapPanel>
     <WrapPanel><Button Content="{loc:Tr Text='Import'}" Click="Import"/><Button Content="{loc:Tr Text='Export'}" Click="Export"/></WrapPanel>
     <Button Content="{loc:Tr Text='Copy AI instructions'}" Click="CopyInstructions" HorizontalAlignment="Left"/>
    </StackPanel>
    <StackPanel x:Name="AssignmentEditor" Grid.Column="2">
     <TextBlock Text="{loc:Tr Text='2. Bind an event to an effect'}" FontWeight="SemiBold" FontSize="16"/>
     <TextBox Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,8"/>
     <CheckBox Content="{loc:Tr Text='Enabled'}" IsChecked="{Binding Draft.Enabled}" Margin="0,0,0,8"/>
     <ComboBox x:Name="EventSelector" ItemsSource="{Binding Events}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Draft.ScreenEventId}"/>
     <TextBlock Text="{Binding Draft.ScreenHelp}" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#665E77"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ComboBox ItemsSource="{Binding Actions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Draft.Action}"/>
      <ComboBox Grid.Column="2" ItemsSource="{Binding Targets}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Draft.ToyId}" DropDownOpened="RefreshTargets"/>
     </Grid>
     <TextBlock Text="{Binding Draft.IntensityText}" Margin="0,10,0,0"/>
     <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Draft.Intensity}"/>
     <controls:EffectPreview Height="60" Kind="{Binding Draft.Action}" Intensity="{Binding Draft.Intensity}" Duration="{Binding Draft.DurationSeconds}" Pulse="{Binding Draft.PulseMs}"/>
     <WrapPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="{loc:Tr Text='Duration · ms'}"/><TextBox Width="108" Text="{Binding Draft.DurationMilliseconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="{loc:Tr Text='Cooldown · seconds'}"/><TextBox Width="108" Text="{Binding Draft.CooldownSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="{loc:Tr Text='Pulse · seconds'}"/><TextBox Width="108" Text="{Binding Draft.PulseSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
     </WrapPanel>
     <Expander Header="{loc:Tr Text='Advanced settings'}"><StackPanel>
      <TextBlock Text="{loc:Tr Text='Priority · higher wins'}"/><TextBox Text="{Binding Draft.Priority, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
      <TextBlock Text="{loc:Tr Text='Window title contains'}"/><TextBox Text="{Binding Draft.WindowTitleContains, UpdateSourceTrigger=PropertyChanged}"/>
     </StackPanel></Expander>
     <TextBlock Text="{Binding Draft.Summary}" TextWrapping="Wrap" Margin="0,8,0,8"/>
     <Button x:Name="SaveAssignmentButton" Content="{loc:Tr Text='Save assignment'}" Click="SaveAssignment" HorizontalAlignment="Left" Background="#7452BA" Foreground="White"/>
    </StackPanel>
   </Grid>
   <TextBlock Text="{loc:Tr Text='Recent game events'}" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8"/>
   <ListBox ItemsSource="{Binding RecentEvents}" Height="115"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
