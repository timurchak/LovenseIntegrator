<UserControl x:Class="LovenseIntegrator.Desktop.ScreenModeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:LovenseIntegrator.Desktop.Localization" xmlns:controls="clr-namespace:LovenseIntegrator.Desktop.Controls">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{loc:Tr Text='Assignments'}" FontWeight="SemiBold" FontSize="16"/>
     <Button Content="{loc:Tr Text='+ Assignment'}" Click="NewAssignment" Margin="0,8,0,8"/><ListBox x:Name="AssignmentList" ItemsSource="{Binding Assignments}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" Height="220" Margin="0,10,0,8"/>

     <WrapPanel><Button Content="{loc:Tr Text='Import'}" Click="Import"/><Button Content="{loc:Tr Text='Export'}" Click="Export"/></WrapPanel>
     <Button Content="{loc:Tr Text='Copy AI instructions'}" Click="CopyInstructions" HorizontalAlignment="Left"/>
</StackPanel></ScrollViewer>
  <controls:AssignmentEditorView x:Name="AssignmentEditor" Grid.Column="2" SaveRequested="SaveAssignment" TestRequested="TestAssignment" DeleteRequested="DeleteAssignment">
   <controls:AssignmentEditorView.TriggerContent><StackPanel>
    <TextBlock Text="{loc:Tr Text='Screen · World of Warcraft'}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <ComboBox x:Name="EventSelector" ItemsSource="{Binding Events}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Draft.ScreenEventId}"/>
    <TextBlock Text="{Binding Draft.ScreenHelp}" Margin="0,8,0,12" Foreground="{StaticResource Muted}"/>
    <Expander Header="{loc:Tr Text='Signal setup and recent events'}" Margin="0,8,0,0"><StackPanel><Border Background="#F2EEFD" CornerRadius="10" Padding="14">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,14,0">
      <TextBlock Text="{loc:Tr Text='1. Read the addon signal'}" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="{loc:Tr Text='Install WowScreenEvents, then /wse show. Defaults: top left, 4 px cells (32 × 32 px block). Use windowed or borderless WoW.'}" Margin="0,8,0,8" TextWrapping="Wrap"/>
      <WrapPanel x:Name="RegionInputs" IsEnabled="{Binding CanConfigure}">
       <StackPanel Margin="0,0,12,8"><TextBlock Text="X · px"/><TextBox Width="72" Text="{Binding Region.X, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
       <StackPanel Margin="0,0,12,8"><TextBlock Text="Y · px"/><TextBox Width="72" Text="{Binding Region.Y, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
       <StackPanel Margin="0,0,12,8"><TextBlock Text="{loc:Tr Text='Cell · px'}"/><TextBox Width="72" Text="{Binding Region.CellSize, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
      </WrapPanel>
      <Button x:Name="MonitorButton" Content="{Binding MonitorLabel}" IsEnabled="{Binding CanToggle}" Click="Monitor" HorizontalAlignment="Left"/>
      <TextBlock x:Name="SignalStatus" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold"/>
     </StackPanel>
     <StackPanel Grid.Column="1"><Border Background="#17152B" Width="104" Height="104" Padding="4"><Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border><TextBlock Text="{loc:Tr Text='Live preview'}" TextAlignment="Center" FontSize="11" Margin="0,5,0,0"/></StackPanel>
    </Grid>
   </Border>
   <TextBlock Text="{loc:Tr Text='Reading alone never activates toys. Enable rules when ready. Leaving WoW or losing a live signal pauses Screen rules; resume manually.'}" TextWrapping="Wrap" Margin="0,10,0,16" Foreground="#665E77"/>

     <TextBlock Text="{loc:Tr Text='Recent game events'}" FontWeight="SemiBold" Margin="0,8,0,8"/><ListBox ItemsSource="{Binding RecentEvents}" Height="115"/>
    </StackPanel></Expander>
    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
   </StackPanel></controls:AssignmentEditorView.TriggerContent>
  </controls:AssignmentEditorView>
 </Grid>
</UserControl>
