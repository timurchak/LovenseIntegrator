<UserControl x:Class="LovenseIntegrator.Desktop.MouseModeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:LovenseIntegrator.Desktop.Localization"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:LovenseIntegrator.Desktop.Controls" Language="en-US">
 <UserControl.Resources>
  <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="3"/><Setter Property="Foreground" Value="#30344B"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D8DCE8"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,6,6"/></Style>
 </UserControl.Resources>
 <Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto">      <StackPanel>
       <TextBlock Text="{loc:Tr Text='Assignments'}" FontSize="16" FontWeight="SemiBold"/>
       <Button Content="{loc:Tr Text='+ Assignment'}" Click="NewAssignment" Margin="0,8,0,8" FontSize="12"/>
       <WrapPanel Margin="0,0,0,4"><Button x:Name="ImportMouseButton" Content="{loc:Tr Text='Import'}" Click="ImportMouse" Style="{StaticResource SmallButton}" ToolTip="{loc:Tr Text='Add from JSON. Matching IDs are updated; other events are preserved.'}"/><Button x:Name="ExportMouseButton" Content="{loc:Tr Text='Export ▾'}" Click="ExportMouse" Style="{StaticResource SmallButton}"><Button.ContextMenu><ContextMenu><MenuItem Header="{loc:Tr Text='All saved assignments'}" Click="ExportAllMouse"/><MenuItem Header="{loc:Tr Text='Selected saved assignment'}" Click="ExportSelectedMouse"/></ContextMenu></Button.ContextMenu></Button></WrapPanel>
       <Button x:Name="AiInstructionsButton" Content="{loc:Tr Text='AI instructions'}" Click="ShowAiInstructions" Background="White" FontSize="11" Margin="0,0,0,8"/>
       <ListBox x:Name="Assignments" ItemsSource="{Binding Groups}" SelectedValuePath="Id" SelectedValue="{Binding SelectedId, Mode=OneWay}" SelectionChanged="AssignmentSelected" MaxHeight="430"><ListBox.ItemTemplate><DataTemplate><StackPanel>
        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding KeysText}" FontSize="10" Foreground="{StaticResource Accent}" Margin="0,4,0,0"/><TextBlock Text="{Binding Scope}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        <TextBlock FontSize="10" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{loc:Tr Text='Disabled'}"/><Setter Property="Foreground" Value="#A47781"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="Text" Value="{loc:Tr Text='Enabled'}"/><Setter Property="Foreground" Value="#49836A"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
       <Button Content="{loc:Tr Text='Duplicate'}" Click="DuplicateAssignment" Background="White" FontSize="11" Margin="0,8,0,0"/>
      </StackPanel></ScrollViewer>
   <controls:AssignmentEditorView x:Name="AssignmentEditor" Grid.Column="2" SaveRequested="SaveAssignment" TestRequested="TestAssignment" DeleteRequested="DeleteAssignment">
    <controls:AssignmentEditorView.TriggerContent><StackPanel><TextBlock Text="{Binding SelectionText}" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
     <WrapPanel>
      <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Text='Whole mouse'}" Tag="all" Click="SelectKeys"/>
      <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Text='Five buttons'}" Tag="buttons" Click="SelectKeys"/><Button Style="{StaticResource SmallButton}" Content="{loc:Tr Text='Wheel ↑ ↓'}" Tag="wheel" Click="SelectKeys"/><Button Style="{StaticResource SmallButton}" Content="{loc:Tr Text='Clear selection'}" Tag="none" Click="SelectKeys" Background="White"/>
     </WrapPanel>
     <Border Background="#F5F6FB" BorderBrush="#E6E8F1" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,6,0,0">
      <Viewbox Stretch="Uniform" MaxHeight="240"><Canvas x:Name="MouseCanvas" Width="640" Height="240"/></Viewbox>
     </Border>
     <TextBlock Text="{loc:Tr Text='Purple: selected · pink: excluded · dot: assigned. Selecting inputs does not send commands.'}" Foreground="{StaticResource Muted}" FontSize="10" Margin="2,8,0,18"/>
<CheckBox Content="{loc:Tr Text='Wheel: vibrate while scrolling'}" IsChecked="{Binding Draft.WheelContinuous}" Margin="0,4,0,4"/><StackPanel Visibility="{Binding Draft.WheelContinuous, Converter={StaticResource Visible}}"><TextBlock Text="{loc:Tr Text='Stop after no scrolling · ms'}" Style="{StaticResource Label}"/><TextBox Width="140" HorizontalAlignment="Left" Text="{Binding Draft.WheelIdleMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel></StackPanel></controls:AssignmentEditorView.TriggerContent>
   </controls:AssignmentEditorView>
  </Grid>
 </Border>
</UserControl>
